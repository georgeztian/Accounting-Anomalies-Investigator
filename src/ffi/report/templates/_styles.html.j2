<style>
:root {
  color-scheme: light;
  --surface-0: #f6f5f2; --surface-1: #fcfcfb; --surface-2: #f0efec; --border: #dedcd5;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77756f;
  --s1: #2a78d6; --s2: #eb6834; --band: rgba(82, 81, 78, 0.12); --grid: #e7e5df; --axis: #a9a79f;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
  --seq-1: #cde2fb; --seq-2: #86b6ef; --seq-3: #3987e5; --seq-4: #1c5cab; --seq-5: #0d366b;
  --fact: #2a78d6; --span: #1baf7a; --derived: #6250d6; --event: #eb6834;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
    --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
    --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
    --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
  --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
  --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
  --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface-0); color: var(--text-primary);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif; }
main { max-width: 980px; margin: 0 auto; padding: 32px 16px 80px; }
h1 { font-size: 26px; line-height: 1.25; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 48px 0 12px; padding-top: 8px; border-top: 1px solid var(--border); }
h3 { font-size: 16px; margin: 0 0 6px; }
p { margin: 8px 0; }
a { color: var(--s1); }
.sub { color: var(--text-secondary); font-size: 14px; }
.muted { color: var(--text-muted); font-size: 13px; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin: 12px 0; }
.hero { display: grid; grid-template-columns: 220px 1fr; gap: 20px; align-items: start; }
@media (max-width: 720px) { .hero { grid-template-columns: 1fr; } }
.index { font-size: 56px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.band { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; margin-top: 8px; }
.band i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.band.Low i { background: var(--good); } .band.Elevated i { background: var(--warning); }
.band.High i { background: var(--serious); } .band.Severe i { background: var(--critical); }
.scale { display: flex; height: 8px; border-radius: 4px; overflow: hidden; margin: 12px 0 4px; gap: 2px; }
.scale span { flex: 1; background: var(--surface-2); } .scale span.on { background: var(--text-secondary); }
ul.tight { margin: 6px 0; padding-left: 20px; } ul.tight li { margin: 3px 0; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--text-secondary); font-weight: 600; font-size: 12.5px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.tablewrap { overflow-x: auto; }
.pill { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--border); white-space: nowrap; }
.pill.flagged { border-color: var(--serious); color: var(--text-primary); }
.pill.flagged::before { content: "▲ "; color: var(--serious); }
.pill.suppressed { color: var(--text-muted); } .pill.skipped, .pill.error, .pill.na { color: var(--text-muted); }
.reading { margin-top: 4px; color: var(--text-secondary); font-size: 13px; }
details.about { margin-top: 4px; font-size: 13px; } details.about summary { cursor: pointer; color: var(--text-secondary); }
details.about dl.kv { margin: 6px 0 2px; }
.glossary dt { font-weight: 600; } .glossary dd { margin: 0 0 8px; color: var(--text-secondary); }
.lead { font-size: 15.5px; }
.pill.error::before { content: "! "; color: var(--critical); }
.heat { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
.heat div { border-radius: 6px; padding: 8px 10px; font-size: 13px; background: var(--surface-2); }
.heat div b { display: block; font-variant-numeric: tabular-nums; }
.heat .l1 { background: var(--seq-1); } .heat .l2 { background: var(--seq-2); } .heat .l3 { background: var(--seq-3); color: #fff; }
.heat .l4 { background: var(--seq-4); color: #fff; } .heat .l5 { background: var(--seq-5); color: #fff; }
:root[data-theme="dark"] .heat .l4, :root[data-theme="dark"] .heat .l5 { color: #0b0b0b; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .heat .l4, :root:not([data-theme="light"]) .heat .l5 { color: #0b0b0b; } }
.finding { border-left: 4px solid var(--serious); }
.audit { font-weight: 600; } .audit.unverified { color: var(--critical); } .audit.verified, .audit.verified_after_corrections { color: var(--good); }
.finding .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--text-secondary); font-size: 13px; margin: 4px 0 10px; }
.kv { display: grid; grid-template-columns: 170px 1fr; gap: 4px 12px; font-size: 14px; }
@media (max-width: 640px) { .kv { grid-template-columns: 1fr; } }
.kv dt { color: var(--text-secondary); } .kv dd { margin: 0; }
blockquote { margin: 6px 0; padding: 6px 12px; border-left: 3px solid var(--span); background: var(--surface-2); font-size: 13.5px; border-radius: 0 6px 6px 0; }
details { margin: 8px 0; } summary { cursor: pointer; color: var(--text-secondary); font-size: 14px; }
figure.chart { margin: 12px 0; } figcaption { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
svg { width: 100%; height: auto; display: block; }
svg .grid { stroke: var(--grid); stroke-width: 1; } svg .zero { stroke: var(--axis); stroke-width: 1; }
svg .tick { fill: var(--text-muted); font-size: 11px; } svg .direct { fill: var(--text-secondary); font-size: 12px; }
svg .rowlabel { fill: var(--text-primary); font-size: 13px; }
svg .line { fill: none; stroke-width: 2; stroke-linejoin: round; } svg .line.s1 { stroke: var(--s1); } svg .line.s2 { stroke: var(--s2); }
svg .dot { stroke: var(--surface-1); stroke-width: 2; } svg .dot.s1 { fill: var(--s1); } svg .dot.s2 { fill: var(--s2); }
svg .dot.peer { fill: var(--axis); } svg .band { fill: var(--band); } svg .ref { stroke: var(--text-secondary); stroke-width: 2; stroke-dasharray: 3 3; }
svg .edge { stroke: var(--grid); stroke-width: 1.5; } svg .nodelabel { fill: var(--text-secondary); font-size: 11.5px; }
svg .node { stroke: var(--surface-1); stroke-width: 2; } svg .node.center { fill: var(--serious); }
svg .node.fact { fill: var(--fact); } svg .node.span { fill: var(--span); } svg .node.derived { fill: var(--derived); } svg .node.event { fill: var(--event); }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--text-secondary); margin-top: 4px; }
.legend .key { display: inline-flex; align-items: center; gap: 6px; }
.sw { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
.sw.s1 { background: var(--s1); } .sw.s2 { background: var(--s2); } .sw.dashed { background: repeating-linear-gradient(90deg, var(--s2) 0 5px, transparent 5px 8px); }
.sw.band { height: 10px; background: var(--band); } .sw.peer { width: 8px; height: 8px; border-radius: 50%; background: var(--axis); }
.sw.ref { background: var(--text-secondary); } .sw.fact, .sw.span, .sw.derived, .sw.event { width: 8px; height: 8px; border-radius: 50%; }
.sw.fact { background: var(--fact); } .sw.span { background: var(--span); } .sw.derived { background: var(--derived); } .sw.event { background: var(--event); }
.disclaimer { font-size: 13px; color: var(--text-secondary); background: var(--surface-2); border-radius: 8px; padding: 10px 14px; }
.toolbar { position: fixed; top: 10px; right: 12px; }
.toolbar button { background: var(--surface-1); color: var(--text-secondary); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 12px; }
nav.toc { font-size: 13.5px; } nav.toc a { margin-right: 14px; white-space: nowrap; }
@media print { .toolbar { display: none; } h2 { break-before: page; } .card { break-inside: avoid; } }
.yeargrid td.cell { text-align: center; font-variant-numeric: tabular-nums; border-radius: 4px; }
.yeargrid .l1 { background: var(--seq-1); } .yeargrid .l2 { background: var(--seq-2); } .yeargrid .l3 { background: var(--seq-3); color: #fff; }
.yeargrid .l4 { background: var(--seq-4); color: #fff; } .yeargrid .l5 { background: var(--seq-5); color: #fff; }
.yearstrip { display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 10px; }
.yearstrip span { font-size: 12px; padding: 2px 7px; border-radius: 99px; border: 1px solid var(--border); color: var(--text-muted); }
.yearstrip span.on { border-color: var(--serious); color: var(--text-primary); font-weight: 600; }
</style>
