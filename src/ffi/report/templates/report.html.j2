<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ m.company.ticker }} {{ m.period }} anomaly report</title>
<style>
:root {
  color-scheme: light;
  --surface-0: #f6f5f2; --surface-1: #fcfcfb; --surface-2: #f0efec; --border: #dedcd5;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77756f;
  --s1: #2a78d6; --s2: #eb6834; --band: rgba(82, 81, 78, 0.12); --grid: #e7e5df; --axis: #a9a79f;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
  --seq-1: #cde2fb; --seq-2: #86b6ef; --seq-3: #3987e5; --seq-4: #1c5cab; --seq-5: #0d366b;
  --fact: #2a78d6; --span: #1baf7a; --derived: #6250d6; --event: #eb6834;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
    --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
    --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
    --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
  --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
  --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
  --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface-0); color: var(--text-primary);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif; }
main { max-width: 980px; margin: 0 auto; padding: 32px 16px 80px; }
h1 { font-size: 26px; line-height: 1.25; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 48px 0 12px; padding-top: 8px; border-top: 1px solid var(--border); }
h3 { font-size: 16px; margin: 0 0 6px; }
p { margin: 8px 0; }
a { color: var(--s1); }
.sub { color: var(--text-secondary); font-size: 14px; }
.muted { color: var(--text-muted); font-size: 13px; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin: 12px 0; }
.hero { display: grid; grid-template-columns: 220px 1fr; gap: 20px; align-items: start; }
@media (max-width: 720px) { .hero { grid-template-columns: 1fr; } }
.index { font-size: 56px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.band { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; margin-top: 8px; }
.band i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.band.Low i { background: var(--good); } .band.Elevated i { background: var(--warning); }
.band.High i { background: var(--serious); } .band.Severe i { background: var(--critical); }
.scale { display: flex; height: 8px; border-radius: 4px; overflow: hidden; margin: 12px 0 4px; gap: 2px; }
.scale span { flex: 1; background: var(--surface-2); } .scale span.on { background: var(--text-secondary); }
ul.tight { margin: 6px 0; padding-left: 20px; } ul.tight li { margin: 3px 0; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--text-secondary); font-weight: 600; font-size: 12.5px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.tablewrap { overflow-x: auto; }
.pill { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--border); white-space: nowrap; }
.pill.flagged { border-color: var(--serious); color: var(--text-primary); }
.pill.flagged::before { content: "▲ "; color: var(--serious); }
.pill.suppressed { color: var(--text-muted); } .pill.skipped, .pill.error { color: var(--text-muted); }
.pill.error::before { content: "! "; color: var(--critical); }
.heat { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
.heat div { border-radius: 6px; padding: 8px 10px; font-size: 13px; background: var(--surface-2); }
.heat div b { display: block; font-variant-numeric: tabular-nums; }
.heat .l1 { background: var(--seq-1); } .heat .l2 { background: var(--seq-2); } .heat .l3 { background: var(--seq-3); color: #fff; }
.heat .l4 { background: var(--seq-4); color: #fff; } .heat .l5 { background: var(--seq-5); color: #fff; }
:root[data-theme="dark"] .heat .l4, :root[data-theme="dark"] .heat .l5 { color: #0b0b0b; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .heat .l4, :root:not([data-theme="light"]) .heat .l5 { color: #0b0b0b; } }
.finding { border-left: 4px solid var(--serious); }
.audit { font-weight: 600; } .audit.unverified { color: var(--critical); } .audit.verified, .audit.verified_after_corrections { color: var(--good); }
.finding .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--text-secondary); font-size: 13px; margin: 4px 0 10px; }
.kv { display: grid; grid-template-columns: 170px 1fr; gap: 4px 12px; font-size: 14px; }
@media (max-width: 640px) { .kv { grid-template-columns: 1fr; } }
.kv dt { color: var(--text-secondary); } .kv dd { margin: 0; }
blockquote { margin: 6px 0; padding: 6px 12px; border-left: 3px solid var(--span); background: var(--surface-2); font-size: 13.5px; border-radius: 0 6px 6px 0; }
details { margin: 8px 0; } summary { cursor: pointer; color: var(--text-secondary); font-size: 14px; }
figure.chart { margin: 12px 0; } figcaption { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
svg { width: 100%; height: auto; display: block; }
svg .grid { stroke: var(--grid); stroke-width: 1; } svg .zero { stroke: var(--axis); stroke-width: 1; }
svg .tick { fill: var(--text-muted); font-size: 11px; } svg .direct { fill: var(--text-secondary); font-size: 12px; }
svg .rowlabel { fill: var(--text-primary); font-size: 13px; }
svg .line { fill: none; stroke-width: 2; stroke-linejoin: round; } svg .line.s1 { stroke: var(--s1); } svg .line.s2 { stroke: var(--s2); }
svg .dot { stroke: var(--surface-1); stroke-width: 2; } svg .dot.s1 { fill: var(--s1); } svg .dot.s2 { fill: var(--s2); }
svg .dot.peer { fill: var(--axis); } svg .band { fill: var(--band); } svg .ref { stroke: var(--text-secondary); stroke-width: 2; stroke-dasharray: 3 3; }
svg .edge { stroke: var(--grid); stroke-width: 1.5; } svg .nodelabel { fill: var(--text-secondary); font-size: 11.5px; }
svg .node { stroke: var(--surface-1); stroke-width: 2; } svg .node.center { fill: var(--serious); }
svg .node.fact { fill: var(--fact); } svg .node.span { fill: var(--span); } svg .node.derived { fill: var(--derived); } svg .node.event { fill: var(--event); }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--text-secondary); margin-top: 4px; }
.legend .key { display: inline-flex; align-items: center; gap: 6px; }
.sw { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
.sw.s1 { background: var(--s1); } .sw.s2 { background: var(--s2); } .sw.dashed { background: repeating-linear-gradient(90deg, var(--s2) 0 5px, transparent 5px 8px); }
.sw.band { height: 10px; background: var(--band); } .sw.peer { width: 8px; height: 8px; border-radius: 50%; background: var(--axis); }
.sw.ref { background: var(--text-secondary); } .sw.fact, .sw.span, .sw.derived, .sw.event { width: 8px; height: 8px; border-radius: 50%; }
.sw.fact { background: var(--fact); } .sw.span { background: var(--span); } .sw.derived { background: var(--derived); } .sw.event { background: var(--event); }
.disclaimer { font-size: 13px; color: var(--text-secondary); background: var(--surface-2); border-radius: 8px; padding: 10px 14px; }
.toolbar { position: fixed; top: 10px; right: 12px; }
.toolbar button { background: var(--surface-1); color: var(--text-secondary); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 12px; }
nav.toc { font-size: 13.5px; } nav.toc a { margin-right: 14px; white-space: nowrap; }
@media print { .toolbar { display: none; } h2 { break-before: page; } .card { break-inside: avoid; } }
</style>
</head>
<body>
<div class="toolbar"><button type="button" onclick="(function(){var r=document.documentElement;var d=r.getAttribute('data-theme')==='dark'||(r.getAttribute('data-theme')===null&&matchMedia('(prefers-color-scheme: dark)').matches);r.setAttribute('data-theme',d?'light':'dark');})()">Theme</button></div>
<main>
<header>
  <div class="sub">Accounting anomaly analysis · {{ m.period }} (fiscal year ended {{ m.period_end }}) · data as of {{ m.as_of }}</div>
  <h1>{{ m.company.name }} ({{ m.company.ticker }})</h1>
  <div class="muted">CIK {{ m.company.cik }} · SIC {{ m.company.sic }} {{ m.company.sic_description }}{% if m.company.auditor %} · Auditor: {{ m.company.auditor }}{% endif %} · Run {{ m.run_id }} · Generated {{ m.generated }} · ffi {{ m.version }} · mode: {{ m.mode }}</div>
  {% for w in m.company.warnings %}<p class="muted">⚠ {{ w }}</p>{% endfor %}
  <nav class="toc" aria-label="Sections"><a href="#summary">Summary</a><a href="#dashboard">Dashboard</a><a href="#findings">Findings</a><a href="#detectors">All detectors</a><a href="#text">Disclosure changes</a><a href="#quality">Data quality</a><a href="#method">Methodology</a></nav>
</header>

<section id="summary">
<h2>Executive summary</h2>
<div class="card hero">
  <div>
    <div class="muted">Risk index (0-100)</div>
    <div class="index">{{ "%.0f"|format(m.risk.index) }}</div>
    <div class="band {{ m.risk.band }}"><i></i>{{ m.risk.band }}</div>
    <div class="scale" aria-hidden="true">{% for b in [25,50,75,100] %}<span class="{{ 'on' if m.risk.index >= b - 25 else '' }}"></span>{% endfor %}</div>
    <div class="muted">Low &lt;25 · Elevated &lt;50 · High &lt;75 · Severe</div>
  </div>
  <div>
    {% if m.findings %}
    <p><strong>{{ m.findings|length }} finding{{ 's' if m.findings|length != 1 }}</strong> ranked by strength × materiality. Top items:</p>
    <ol class="tight">{% for s in m.top_sentences %}<li>{{ s }}</li>{% endfor %}</ol>
    {% else %}
    <p>No detector pattern reached the reporting threshold. Individual signals are listed under <a href="#detectors">All detectors</a>.</p>
    {% endif %}
    <p class="muted">Independent audit of the findings: {{ m.audit_summary.verified }} verified, {{ m.audit_summary.corrected }} verified after corrections, {{ m.audit_summary.unverified }} unverified (correction loop of at most 3 rounds; unverified findings carry half weight).</p>
    <p class="muted">The index is a weighted combination of flagged signals and corroborated patterns, not a calibrated probability{% if m.risk.probability is not none %} (model probability {{ "%.1f"|format(m.risk.probability*100) }}%){% endif %}. Peer set: {{ m.peer_note }}.</p>
    {% if m.findings and m.findings[0].questions %}<p><strong>What would most change the conclusion:</strong> {{ m.findings[0].questions[0] }}</p>{% endif %}
  </div>
</div>
<div class="card tablewrap"><table>
  <thead><tr><th>Key figures (as first reported)</th><th class="num">{{ m.period }}</th><th class="num">Prior year</th></tr></thead>
  <tbody>{% for k in m.key_numbers %}<tr><td>{{ k.label }}</td><td class="num">{{ k.value }}</td><td class="num">{{ k.prior }}</td></tr>{% endfor %}</tbody>
</table></div>
<p class="disclaimer">{{ m.disclaimer }}</p>
</section>

<section id="dashboard">
<h2>Risk dashboard</h2>
<div class="card">
  <h3>Signal strength by area</h3>
  <p class="muted">Highest flagged severity per accounting area (0 = nothing flagged).</p>
  <div class="heat">{% for a in m.areas %}{% set lvl = 0 if a.score < 0.01 else (1 if a.score < 0.3 else (2 if a.score < 0.5 else (3 if a.score < 0.7 else (4 if a.score < 0.85 else 5)))) %}<div class="l{{ lvl }}" title="{{ a.area }}: {{ a.score }}">{{ a.area|replace('_',' ') }}<b>{{ "%.2f"|format(a.score) }}</b></div>{% endfor %}</div>
</div>
<div class="card">{{ m.charts.earnings_cash|safe }}<p class="muted">Persistent gaps between earnings and operating cash flow are the most common footprint of aggressive accruals.</p></div>
<div class="card">{{ m.charts.scores|safe }}<p class="muted">Published cut-offs are reference points from the original studies, not verdicts; peer position matters more.</p></div>
{% if m.pressure %}<div class="card"><h3>Pressure and governance context</h3><ul class="tight">{% for p in m.pressure %}<li><strong>{{ p.id }} {{ p.name }}:</strong> {{ p.rationale }}</li>{% endfor %}</ul></div>{% endif %}
</section>

<section id="findings">
<h2>Findings</h2>
{% if not m.findings %}<p>No findings met the reporting threshold.</p>{% endif %}
{% for f in m.findings %}
<article class="card finding" id="f-{{ f.rank }}">
  <h3>{{ f.rank }}. {{ f.title }}</h3>
  <div class="meta"><span>Strength {{ "%.2f"|format(f.score) }}</span><span>Detectors: {{ f.detectors|join(', ') }}</span><span>Narrative: {{ f.narrative_source }}</span>
    {% if f.audit %}<span class="audit {{ f.audit.status }}">{{ '✓' if f.audit.status != 'unverified' else '!' }} {{ f.audit.label }}</span>{% endif %}</div>
  <p>{{ f.narrative }}</p>
  <dl class="kv">
    <dt>Estimated impact</dt><dd>{{ f.impact_text }}{% if f.impact %} <span class="muted">({{ f.impact.method|replace('_',' ') }}: {{ f.impact.basis }})</span>{% endif %}</dd>
    {% if f.materiality_text %}<dt>Materiality</dt><dd>{{ f.materiality_text }}</dd>{% endif %}
    {% if f.sab99 %}<dt>SAB 99 qualitative</dt><dd>{{ f.sab99|join('; ') }}</dd>{% endif %}
  </dl>
  {{ f.chart|safe }}
  <details open><summary>Signals ({{ f.signals|length }})</summary>
    <div class="tablewrap"><table><thead><tr><th>Detector</th><th class="num">Severity</th><th>What was observed</th></tr></thead><tbody>
    {% for s in f.signals %}<tr><td>{{ s.id }} {{ s.name }}</td><td class="num">{{ "%.2f"|format(s.severity) }}</td><td>{{ s.rationale }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>
  <details><summary>Evidence ({{ f.evidence|length }})</summary>
    {{ f.graph|safe }}
    <div class="tablewrap"><table><thead><tr><th>Evidence</th><th>Source</th><th class="num">Value</th></tr></thead><tbody>
    {% for e in f.evidence %}<tr><td>{{ e.label }}{% if e.quote %}<blockquote>{{ e.quote }}</blockquote>{% endif %}{% if e.concept %}<div class="muted">{{ e.concept }}</div>{% endif %}</td>
      <td>{% if e.doc_url %}<a href="{{ e.doc_url }}" target="_blank" rel="noopener">{{ e.accession or 'document' }}</a>{% else %}{{ e.kind }}{% endif %}{% if e.filed %}<div class="muted">filed {{ e.filed }}</div>{% endif %}</td>
      <td class="num">{{ e.value_fmt or '' }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>
  {% if f.audit %}<details><summary>Independent audit ({{ f.audit.rounds|length }} round{{ 's' if f.audit.rounds|length != 1 }})</summary>
    <div class="tablewrap"><table><thead><tr><th>Round</th><th>Check</th><th>Result</th><th>Detail</th></tr></thead><tbody>
    {% for r in f.audit.rounds %}{% for c in r.checks %}<tr><td>{{ r.round }}</td><td>{{ c.name|replace('_',' ') }}</td><td><span class="pill {{ 'flagged' if c.status == 'fail' else 'normal' }}">{{ c.status }}</span></td><td>{{ c.detail }}</td></tr>{% endfor %}
    {% for fix in r.corrections %}<tr><td>{{ r.round }}</td><td>correction</td><td><span class="pill normal">applied</span></td><td>{{ fix }}</td></tr>{% endfor %}{% endfor %}
    </tbody></table></div></details>{% endif %}
  <details><summary>Innocent explanations considered</summary><ul class="tight">{% for a in f.alternatives %}<li>{{ a }}</li>{% endfor %}</ul></details>
  <details open><summary>Questions for management or auditors</summary><ul class="tight">{% for q in f.questions %}<li>{{ q }}</li>{% endfor %}</ul></details>
</article>
{% endfor %}
</section>

<section id="detectors">
<h2>All detector results</h2>
<p class="muted">{{ m.statuses.ok }} detectors ran, {{ m.statuses.skipped }} were skipped (with reasons), {{ m.statuses.error }} errored. Severity is 0-1; flagged at 0.5 unless noted.</p>
{% for fam in m.families %}
<details class="card" {% if fam.flagged %}open{% endif %}><summary><strong>Family {{ fam.code }} · {{ fam.name }}</strong> - {{ fam.flagged }} flagged of {{ fam.ran }} that ran</summary>
<div class="tablewrap"><table><thead><tr><th>ID</th><th>Detector</th><th>Status</th><th class="num">Severity</th><th class="num">Peer pctl</th><th>Detail</th></tr></thead><tbody>
{% for r in fam.rows %}<tr><td>{{ r.id }}</td><td>{{ r.name }}{% if r.period %}<div class="muted">{{ r.period }}</div>{% endif %}</td><td><span class="pill {{ r.status }}">{{ r.status }}</span></td>
<td class="num">{{ "%.2f"|format(r.severity) if r.severity is not none else '' }}</td><td class="num">{{ r.pct_peer if r.pct_peer is not none else '' }}</td><td>{{ r.detail }}</td></tr>{% endfor %}
</tbody></table></div></details>
{% endfor %}
</section>

<section id="text">
<h2>Text and disclosure changes</h2>
{% if not m.text_changes %}<p class="muted">No text-based signals produced evidence for this period.</p>{% endif %}
{% for t in m.text_changes %}<div class="card"><h3>{{ t.id }} {{ t.name }}</h3><p>{{ t.rationale }}</p>{% for q in t.quotes %}<blockquote>{{ q.quote }} <a href="{{ q.doc_url }}" target="_blank" rel="noopener">source</a></blockquote>{% endfor %}</div>{% endfor %}
</section>

<section id="quality">
<h2>Data quality</h2>
<div class="card tablewrap"><table><thead><tr><th>Integrity check</th><th>Status</th><th>Detail</th></tr></thead><tbody>
{% for r in m.integrity %}<tr><td>{{ r.id }} {{ r.name }}</td><td><span class="pill {{ r.status }}">{{ r.status }}</span></td><td>{{ r.detail }}</td></tr>{% endfor %}
</tbody></table></div>
{% if m.notes %}<div class="card"><h3>Run notes</h3><ul class="tight">{% for n in m.notes %}<li>{{ n }}</li>{% endfor %}</ul></div>{% endif %}
</section>

<section id="method">
<h2>Methodology and limitations</h2>
<div class="card">
<dl class="kv">
  <dt>Company resolution</dt><dd>{{ m.company.match_note }}</dd>
  <dt>Point in time</dt><dd>Only filings public on or before {{ m.as_of }} were used; the company's own numbers are as first reported.</dd>
  <dt>Peer set</dt><dd>{{ m.peer_method }}. Industry cross-section: {{ m.industry.size }} registrants at the {{ m.industry.digits }}-digit SIC level (XBRL frames; frames carry latest values).</dd>
  <dt>Knowledge graph</dt><dd>{% for k, v in m.kg.items() %}{{ k }}: {{ v }}{{ ', ' if not loop.last }}{% endfor %}</dd>
  <dt>LLM</dt><dd>{% if m.llm %}{{ m.llm.calls }} calls, ${{ "%.2f"|format(m.llm.usd) }} ({{ m.llm.reasoning_model }} / {{ m.llm.extraction_model }}){% else %}Not used (deterministic mode){% endif %}</dd>
  {% if m.agent %}<dt>Agent decisions</dt><dd><ul class="tight">{% for c in m.agent %}<li>{{ c.finding_id }}: {{ c.status }}{% for d in c.decisions %}; {{ d.interrupt }} → {{ d.choice }}{% if d.auto %} (auto){% endif %}{% endfor %}</li>{% endfor %}</ul></dd>{% endif %}
  <dt>Explained-away checks</dt><dd>{% if m.explain_conditions %}{% for k, v in m.explain_conditions.items() %}{{ v }}{{ '; ' if not loop.last }}{% endfor %}{% else %}No acquisition, standard adoption or split detected in the focus year.{% endif %}</dd>
</dl>
<details><summary>Peers</summary><div class="tablewrap"><table><thead><tr><th>CIK</th><th>Name</th><th class="num">Distance</th></tr></thead><tbody>{% for p in m.peers %}<tr><td>{{ p.cik }}</td><td>{{ p.name }}</td><td class="num">{{ p.distance }}</td></tr>{% endfor %}</tbody></table></div></details>
<details><summary>Source documents</summary><ul class="tight">{% for d in m.documents %}<li><a href="{{ d.url }}" target="_blank" rel="noopener">{{ d.form }} {{ d.period }} ({{ d.accession }})</a></li>{% endfor %}</ul></details>
<p class="muted">Limitations: the app finds reporting anomalies in public filings; it cannot verify cash, assets or transactions. Dimensional (segment) XBRL is not used. Skipped detectors are listed with reasons above.</p>
</div>
<p class="disclaimer">{{ m.disclaimer }}</p>
</section>
</main>
</body>
</html>
