<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ m.company.name }} accounting review</title>
<style>
:root {
  color-scheme: light;
  --surface-0: #f6f5f2; --surface-1: #fcfcfb; --surface-2: #f0efec; --border: #dedcd5;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #77756f;
  --s1: #2a78d6; --s2: #eb6834; --band: rgba(82, 81, 78, 0.12); --grid: #e7e5df; --axis: #a9a79f;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
  --seq-1: #cde2fb; --seq-2: #86b6ef; --seq-3: #3987e5; --seq-4: #1c5cab; --seq-5: #0d366b;
  --fact: #2a78d6; --span: #1baf7a; --derived: #6250d6; --event: #eb6834;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
    --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
    --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
    --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211; --surface-1: #1a1a19; --surface-2: #262624; --border: #383835;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #9a988f;
  --s1: #3987e5; --s2: #d95926; --band: rgba(195, 194, 183, 0.14); --grid: #2c2c2a; --axis: #5c5b56;
  --seq-1: #184f95; --seq-2: #1c5cab; --seq-3: #3987e5; --seq-4: #86b6ef; --seq-5: #cde2fb;
  --fact: #3987e5; --span: #199e70; --derived: #9085e9; --event: #d95926;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface-0); color: var(--text-primary);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif; }
main { max-width: 980px; margin: 0 auto; padding: 32px 16px 80px; }
h1 { font-size: 26px; line-height: 1.25; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 48px 0 12px; padding-top: 8px; border-top: 1px solid var(--border); }
h3 { font-size: 16px; margin: 0 0 6px; }
p { margin: 8px 0; }
a { color: var(--s1); }
.sub { color: var(--text-secondary); font-size: 14px; }
.muted { color: var(--text-muted); font-size: 13px; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; margin: 12px 0; }
.hero { display: grid; grid-template-columns: 220px 1fr; gap: 20px; align-items: start; }
@media (max-width: 720px) { .hero { grid-template-columns: 1fr; } }
.index { font-size: 56px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.band { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; margin-top: 8px; }
.band i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.band.Low i { background: var(--good); } .band.Elevated i { background: var(--warning); }
.band.High i { background: var(--serious); } .band.Severe i { background: var(--critical); }
.scale { display: flex; height: 8px; border-radius: 4px; overflow: hidden; margin: 12px 0 4px; gap: 2px; }
.scale span { flex: 1; background: var(--surface-2); } .scale span.on { background: var(--text-secondary); }
ul.tight { margin: 6px 0; padding-left: 20px; } ul.tight li { margin: 3px 0; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--text-secondary); font-weight: 600; font-size: 12.5px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.tablewrap { overflow-x: auto; }
.pill { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--border); white-space: nowrap; }
.pill.flagged { border-color: var(--serious); color: var(--text-primary); }
.pill.flagged::before { content: "▲ "; color: var(--serious); }
.pill.suppressed { color: var(--text-muted); } .pill.skipped, .pill.error, .pill.na { color: var(--text-muted); }
.reading { margin-top: 4px; color: var(--text-secondary); font-size: 13px; }
details.about { margin-top: 4px; font-size: 13px; } details.about summary { cursor: pointer; color: var(--text-secondary); }
details.about dl.kv { margin: 6px 0 2px; }
.glossary dt { font-weight: 600; } .glossary dd { margin: 0 0 8px; color: var(--text-secondary); }
.lead { font-size: 15.5px; }
.pill.error::before { content: "! "; color: var(--critical); }
.heat { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
.heat div { border-radius: 6px; padding: 8px 10px; font-size: 13px; background: var(--surface-2); }
.heat div b { display: block; font-variant-numeric: tabular-nums; }
.heat .l1 { background: var(--seq-1); } .heat .l2 { background: var(--seq-2); } .heat .l3 { background: var(--seq-3); color: #fff; }
.heat .l4 { background: var(--seq-4); color: #fff; } .heat .l5 { background: var(--seq-5); color: #fff; }
:root[data-theme="dark"] .heat .l4, :root[data-theme="dark"] .heat .l5 { color: #0b0b0b; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .heat .l4, :root:not([data-theme="light"]) .heat .l5 { color: #0b0b0b; } }
.finding { border-left: 4px solid var(--serious); }
.audit { font-weight: 600; } .audit.unverified { color: var(--critical); } .audit.verified, .audit.verified_after_corrections { color: var(--good); }
.finding .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--text-secondary); font-size: 13px; margin: 4px 0 10px; }
.kv { display: grid; grid-template-columns: 170px 1fr; gap: 4px 12px; font-size: 14px; }
@media (max-width: 640px) { .kv { grid-template-columns: 1fr; } }
.kv dt { color: var(--text-secondary); } .kv dd { margin: 0; }
blockquote { margin: 6px 0; padding: 6px 12px; border-left: 3px solid var(--span); background: var(--surface-2); font-size: 13.5px; border-radius: 0 6px 6px 0; }
details { margin: 8px 0; } summary { cursor: pointer; color: var(--text-secondary); font-size: 14px; }
figure.chart { margin: 12px 0; } figcaption { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
svg { width: 100%; height: auto; display: block; }
svg .grid { stroke: var(--grid); stroke-width: 1; } svg .zero { stroke: var(--axis); stroke-width: 1; }
svg .tick { fill: var(--text-muted); font-size: 11px; } svg .direct { fill: var(--text-secondary); font-size: 12px; }
svg .rowlabel { fill: var(--text-primary); font-size: 13px; }
svg .line { fill: none; stroke-width: 2; stroke-linejoin: round; } svg .line.s1 { stroke: var(--s1); } svg .line.s2 { stroke: var(--s2); }
svg .dot { stroke: var(--surface-1); stroke-width: 2; } svg .dot.s1 { fill: var(--s1); } svg .dot.s2 { fill: var(--s2); }
svg .dot.peer { fill: var(--axis); } svg .band { fill: var(--band); } svg .ref { stroke: var(--text-secondary); stroke-width: 2; stroke-dasharray: 3 3; }
svg .edge { stroke: var(--grid); stroke-width: 1.5; } svg .nodelabel { fill: var(--text-secondary); font-size: 11.5px; }
svg .node { stroke: var(--surface-1); stroke-width: 2; } svg .node.center { fill: var(--serious); }
svg .node.fact { fill: var(--fact); } svg .node.span { fill: var(--span); } svg .node.derived { fill: var(--derived); } svg .node.event { fill: var(--event); }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--text-secondary); margin-top: 4px; }
.legend .key { display: inline-flex; align-items: center; gap: 6px; }
.sw { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
.sw.s1 { background: var(--s1); } .sw.s2 { background: var(--s2); } .sw.dashed { background: repeating-linear-gradient(90deg, var(--s2) 0 5px, transparent 5px 8px); }
.sw.band { height: 10px; background: var(--band); } .sw.peer { width: 8px; height: 8px; border-radius: 50%; background: var(--axis); }
.sw.ref { background: var(--text-secondary); } .sw.fact, .sw.span, .sw.derived, .sw.event { width: 8px; height: 8px; border-radius: 50%; }
.sw.fact { background: var(--fact); } .sw.span { background: var(--span); } .sw.derived { background: var(--derived); } .sw.event { background: var(--event); }
.disclaimer { font-size: 13px; color: var(--text-secondary); background: var(--surface-2); border-radius: 8px; padding: 10px 14px; }
.toolbar { position: fixed; top: 10px; right: 12px; }
.toolbar button { background: var(--surface-1); color: var(--text-secondary); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 12px; }
nav.toc { font-size: 13.5px; } nav.toc a { margin-right: 14px; white-space: nowrap; }
@media print { .toolbar { display: none; } h2 { break-before: page; } .card { break-inside: avoid; } }
</style>
</head>
<body>
<div class="toolbar"><button type="button" onclick="(function(){var r=document.documentElement;var d=r.getAttribute('data-theme')==='dark'||(r.getAttribute('data-theme')===null&&matchMedia('(prefers-color-scheme: dark)').matches);r.setAttribute('data-theme',d?'light':'dark');})()">Theme</button></div>
<main>
<header>
  <div class="sub">Accounting review · {{ m.period }} (fiscal year ended {{ m.period_end }}) · based on filings available on {{ m.as_of }}</div>
  <h1>{{ m.company.name }}{% if m.company.ticker %} ({{ m.company.ticker }}){% endif %}</h1>
  <div class="muted">{% if m.company.sic_description %}Industry: {{ m.company.sic_description }} · {% endif %}{% if m.company.auditor %}Auditor: {{ m.company.auditor }} · {% endif %}Prepared {{ m.generated }}</div>
  {% if m.profile %}<p class="muted">Company type: <strong>{{ m.profile.label }}</strong> · amounts in {{ m.currency }}{% if m.profile.excluded %} · {{ m.profile.excluded }} tests do not apply to this type of company and were not run{% endif %}</p>{% endif %}
  {% for w in m.company.warnings %}<p class="muted">Note: {{ w }}</p>{% endfor %}
  <nav class="toc" aria-label="Sections"><a href="#summary">Summary</a><a href="#dashboard">Overview</a><a href="#findings">Findings</a><a href="#tests">All tests</a><a href="#text">Disclosure changes</a><a href="#method">How this review works</a><a href="#glossary">Glossary</a></nav>
</header>

<section id="summary">
<h2>Summary</h2>
<div class="card hero">
  <div>
    <div class="muted">Risk index (0-100)</div>
    <div class="index">{{ "%.0f"|format(m.risk.index) }}</div>
    <div class="band {{ m.risk.band }}"><i></i>{{ m.risk.band }}</div>
    <div class="scale" aria-hidden="true">{% for b in [25,50,75,100] %}<span class="{{ 'on' if m.risk.index >= b - 25 else '' }}"></span>{% endfor %}</div>
    <div class="muted">Low below 25 · Elevated below 50 · High below 75 · Severe 75 and above</div>
  </div>
  <div>
    {% if m.findings %}
    <p class="lead"><strong>{{ m.findings|length }} matter{{ 's' if m.findings|length != 1 }} worth following up</strong>, most important first:</p>
    <ol class="tight">{% for s in m.top_sentences %}<li>{{ s }}</li>{% endfor %}</ol>
    {% else %}
    <p class="lead">None of the tests found a warning sign strong enough to report as a finding. Every test result is listed under <a href="#tests">All tests</a>.</p>
    {% endif %}
    {% if m.findings %}<p class="muted">Every finding was independently re-checked against the original filings: {{ m.audit_summary.verified }} confirmed, {{ m.audit_summary.corrected }} confirmed after corrections, {{ m.audit_summary.unverified }} could not be fully confirmed and count for half.</p>{% endif %}
    <p class="muted">The risk index summarises how many warning signs were found and how strong they are. It is a screening score, not the probability that anything is wrong. Comparison group: {{ m.peer_method }}</p>
    {% if m.findings and m.findings[0].questions %}<p><strong>The question that would most change this conclusion:</strong> {{ m.findings[0].questions[0] }}</p>{% endif %}
  </div>
</div>
<div class="card tablewrap"><table>
  <thead><tr><th>Key figures (as first reported)</th><th class="num">{{ m.period }}</th><th class="num">Prior year</th></tr></thead>
  <tbody>{% for k in m.key_numbers %}<tr><td>{{ k.label }}</td><td class="num">{{ k.value }}</td><td class="num">{{ k.prior }}</td></tr>{% endfor %}</tbody>
</table></div>
<p class="disclaimer">{{ m.disclaimer }}</p>
</section>

<section id="dashboard">
<h2>Overview</h2>
<div class="card">
  <h3>Warning-sign strength by accounting area</h3>
  <p class="muted">The strongest test result in each area, from 0 (nothing unusual) to 1 (strongest).</p>
  <div class="heat">{% for a in m.areas %}{% set lvl = 0 if a.score < 0.01 else (1 if a.score < 0.3 else (2 if a.score < 0.5 else (3 if a.score < 0.7 else (4 if a.score < 0.85 else 5)))) %}<div class="l{{ lvl }}" title="{{ a.area }}: {{ a.score }}">{{ a.area }}<b>{{ "%.2f"|format(a.score) }}</b></div>{% endfor %}</div>
</div>
{% if m.charts.earnings_cash %}<div class="card">{{ m.charts.earnings_cash|safe }}<p class="muted">Over time, profits should turn into cash. A persistent gap between net income and the cash the business generates is the most common sign that profits rely heavily on estimates.</p></div>{% endif %}
{% if m.charts.scores %}<div class="card">{{ m.charts.scores|safe }}<p class="muted">Academic scoring models that resemble the financial profile of companies later found to have misstated their results. The dashed line is each model's published warning level; the grey dots are the comparison companies. Where the company sits relative to its peers matters more than the line.</p></div>{% endif %}
{% if m.pressure %}<div class="card"><h3>Context: pressures on management</h3><p class="muted">These are not warning signs in themselves, but pressure (financial strain, leadership changes) makes earnings management more likely.</p><ul class="tight">{% for p in m.pressure %}<li><strong>{{ p.name }}:</strong> {{ p.rationale }}</li>{% endfor %}</ul></div>{% endif %}
</section>

<section id="findings">
<h2>Findings</h2>
{% if not m.findings %}<p>No findings met the reporting threshold.</p>{% endif %}
{% for f in m.findings %}
<article class="card finding" id="f-{{ f.rank }}">
  <h3>{{ f.rank }}. {{ f.title }}</h3>
  <div class="meta"><span>Strength of evidence: {{ f.strength }} ({{ "%.2f"|format(f.score) }} of 1)</span><span>Based on: {{ f.tests|join('; ') }}</span>
    {% if f.audit %}<span class="audit {{ f.audit.status }}">{{ '✓' if f.audit.status != 'unverified' else '!' }} {{ f.audit.label }}</span>{% endif %}</div>
  <p>{{ f.narrative }}</p>
  <dl class="kv">
    <dt>Estimated effect on profit</dt><dd>{{ f.impact_text }}{% if f.impact_basis %} <span class="muted">(how it was estimated: {{ f.impact_basis }})</span>{% endif %}</dd>
    {% if f.materiality_text %}<dt>Is it material?</dt><dd>{{ f.materiality_text }}</dd>{% endif %}
    {% if f.sab99 %}<dt>Other reasons it could matter</dt><dd>{{ f.sab99|join('; ') }} <span class="muted">(qualitative factors from SEC guidance on materiality)</span></dd>{% endif %}
  </dl>
  {{ f.chart|safe }}
  <details open><summary>What the tests found ({{ f.signals|length }})</summary>
    {% for s in f.signals %}<div class="card">
      <h3>{{ s.name }} <span class="muted">· severity {{ "%.2f"|format(s.severity) }}{% if s.period %} · {{ s.period }}{% endif %}</span></h3>
      <p>{{ s.rationale }}</p>
      <p class="reading"><strong>What this result means:</strong> {{ s.reading }}</p>
      {% if s.what %}<dl class="kv"><dt>What the test checks</dt><dd>{{ s.what }}</dd><dt>Why it matters</dt><dd>{{ s.why }}</dd><dt>How to interpret it</dt><dd>{{ s.how_to_read }}</dd></dl>{% endif %}
    </div>{% endfor %}
  </details>
  <details><summary>Supporting evidence ({{ f.evidence|length }})</summary>
    {{ f.graph|safe }}
    <div class="tablewrap"><table><thead><tr><th>Evidence</th><th>Source</th><th class="num">Value</th></tr></thead><tbody>
    {% for e in f.evidence %}<tr><td>{{ e.label }} <span class="muted">· {{ e.kind_label }}</span>{% if e.quote %}<blockquote>{{ e.quote }}</blockquote>{% endif %}</td>
      <td>{% if e.doc_url %}<a href="{{ e.doc_url }}" target="_blank" rel="noopener">{{ e.source }}</a>{% else %}{{ e.source }}{% endif %}</td>
      <td class="num">{{ e.value_fmt or '' }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>
  {% if f.audit %}<details><summary>Independent re-check ({{ f.audit.rounds|length }} round{{ 's' if f.audit.rounds|length != 1 }})</summary>
    <p class="muted">A separate check re-reads every figure and quote from the original filings and recalculates the impact. Problems are corrected and re-checked, up to three rounds.</p>
    <div class="tablewrap"><table><thead><tr><th>Round</th><th>Check</th><th>Result</th><th>Detail</th></tr></thead><tbody>
    {% for r in f.audit.rounds %}{% for c in r.checks %}<tr><td>{{ r.round }}</td><td>{{ c.label }}</td><td><span class="pill {{ 'flagged' if c.status == 'fail' else 'normal' }}">{{ {'pass': 'passed', 'fail': 'failed', 'warn': 'note'}.get(c.status, c.status) }}</span></td><td>{{ c.detail }}</td></tr>{% endfor %}
    {% for fix in r.corrections %}<tr><td>{{ r.round }}</td><td>Correction</td><td><span class="pill normal">applied</span></td><td>{{ fix }}</td></tr>{% endfor %}{% endfor %}
    </tbody></table></div></details>{% endif %}
  <details><summary>Innocent explanations to rule out</summary><ul class="tight">{% for a in f.alternatives %}<li>{{ a }}</li>{% endfor %}</ul></details>
  <details open><summary>Questions to ask management or the auditors</summary><ul class="tight">{% for q in f.questions %}<li>{{ q }}</li>{% endfor %}</ul></details>
</article>
{% endfor %}
</section>

<section id="tests">
<h2>All tests performed</h2>
<p class="muted">{{ m.statuses.ok }} tests ran; {{ m.statuses.skipped }} could not run because data was missing; {{ m.statuses['n/a'] }} do not apply to this type of company{% if m.statuses.error %}; {{ m.statuses.error }} failed{% endif %}. Severity runs from 0 (nothing unusual) to 1 (strongest); a result is flagged at {{ "%.1f"|format(m.flag_at) }}. "Explained" means the result was unusual but a known legitimate cause was found. Open "About this test" for what each test checks, why it matters and how to read it.</p>
{% for fam in m.families %}
<details class="card" {% if fam.flagged %}open{% endif %}><summary><strong>{{ fam.name }}</strong> - {{ fam.flagged }} flagged of {{ fam.ran }} that ran</summary>
<div class="tablewrap"><table><thead><tr><th>Test</th><th>Result</th><th class="num">Severity</th><th class="num">Peer percentile</th><th>What was found</th></tr></thead><tbody>
{% for r in fam.rows %}<tr><td>{{ r.name }}{% if r.period %}<div class="muted">{{ r.period }}</div>{% endif %}</td><td><span class="pill {{ r.status|replace('/', '') }}">{{ r.status_label }}</span></td>
<td class="num">{{ "%.2f"|format(r.severity) if r.severity is not none else '' }}</td><td class="num">{{ r.pct_peer if r.pct_peer is not none else '' }}</td><td>{{ r.detail }}
{% if r.reading and r.reading != r.detail %}<div class="reading">{{ r.reading }}</div>{% endif %}
{% if r.what and r.first %}<details class="about"><summary>About this test</summary><dl class="kv">
<dt>What it checks</dt><dd>{{ r.what }}</dd><dt>Why it matters</dt><dd>{{ r.why }}</dd><dt>How to interpret it</dt><dd>{{ r.how_to_read }}</dd></dl></details>{% endif %}</td></tr>{% endfor %}
</tbody></table></div></details>
{% endfor %}
</section>

<section id="text">
<h2>Changes in the company's disclosures</h2>
{% if not m.text_changes %}<p class="muted">The text review did not find disclosure changes worth highlighting for this period.</p>{% endif %}
{% for t in m.text_changes %}<div class="card"><h3>{{ t.name }}</h3><p>{{ t.rationale }}</p>{% for q in t.quotes %}<blockquote>{{ q.quote }} <a href="{{ q.doc_url }}" target="_blank" rel="noopener">{{ q.source }}</a></blockquote>{% endfor %}</div>{% endfor %}
</section>

<section id="method">
<h2>How this review works</h2>
<div class="card">
<dl class="kv">
  <dt>Company</dt><dd>{{ m.company.match_note }}</dd>
  {% if m.profile %}<dt>Company type</dt><dd>{{ m.profile.label }}. {{ m.profile.description }}{% for n in m.profile.notes %} {{ n }}{% endfor %}</dd>{% endif %}
  <dt>What was analysed</dt><dd>{{ m.analysis_type }}. The figures come from the company's filings with the US Securities and Exchange Commission (SEC).</dd>
  <dt>Point in time</dt><dd>Only filings public on or before {{ m.as_of }} were used, and the company's figures are taken as first reported, before any later corrections.</dd>
  <dt>Comparison group</dt><dd>{{ m.peer_method }}</dd>
  <dt>Legitimate causes checked</dt><dd>{% if m.explain_conditions %}{% for k, v in m.explain_conditions.items() %}{{ v }}{{ '; ' if not loop.last }}{% endfor %}{% else %}No acquisition, change in accounting standards or stock split was found in the year reviewed, so no results were discounted for those reasons.{% endif %}</dd>
  {% if m.notes %}<dt>Data notes</dt><dd><ul class="tight">{% for n in m.notes %}<li>{{ n }}</li>{% endfor %}</ul></dd>{% endif %}
</dl>
{% if m.peers %}<details><summary>Comparison companies</summary><ul class="tight">{% for p in m.peers %}<li>{{ p.name }}</li>{% endfor %}</ul></details>{% endif %}
<details><summary>Filings read</summary><ul class="tight">{% for d in m.documents %}<li><a href="{{ d.url }}" target="_blank" rel="noopener">{{ d.label }}</a></li>{% endfor %}</ul></details>
<p class="muted">Limitations: this review looks for unusual patterns in public filings. It cannot verify cash, assets or transactions, and segment-level figures are not used. Tests that could not run are listed with the reason.</p>
</div>
</section>

<section id="glossary">
<h2>Glossary</h2>
<div class="card"><dl class="glossary">{% for term, meaning in m.glossary %}<dt>{{ term }}</dt><dd>{{ meaning }}</dd>{% endfor %}</dl></div>
<p class="disclaimer">{{ m.disclaimer }}</p>
</section>
</main>
</body>
</html>
