# Required: SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"
# Optional: enables Family E text extraction and the investigation agent.
# Leave empty to use your Claude subscription through the Claude Code CLI (log in once with `claude`).
ANTHROPIC_API_KEY=
# FFI_LLM_BACKEND=auto          # auto | claude-code | api
# FFI_CLAUDE_CLI=               # path to claude / claude.exe if it isn't found automatically
# Optional overrides
# FFI_CACHE_DIR=.cache
# FFI_REASONING_MODEL=claude-opus-5-5
# FFI_EXTRACTION_MODEL=claude-haiku-5-5
